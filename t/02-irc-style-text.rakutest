use Test;
use IRC::TextColor;

plan 6;

is-deeply
  irc-style-text('text', :style<bold>, :color<teal>, :bgcolor<blue>),
  "\x[2]\x[3]10,02text\x[F]",
  "irc-style-text works";

is-deeply
  ircstyle('text', :bold, :teal),
  irc-style-text('text', :color<teal>, :style<bold>),
  "ircstyle works with bold and color";

is-deeply
  ircstyle('text', :bold),
  irc-style-text('text', :style<bold>),
  "ircstyle works with just bold";

is-deeply
  ircstyle('text', :teal),
  irc-style-text('text', :color<teal>),
  "ircstyle texts with just color";

is-deeply irc-style-text(42), '42', 'irc-style-text can take a Cool';
is-deeply ircstyle(42),       '42', 'ircstyle can take a Cool';

# vim: expandtab shiftwidth=4
